<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <Import Project="..\HSDT.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HdtArenaHelper\HdtArenaHelper.csproj" />
    <ProjectReference Include="..\HdtArenaHelper.Training\HdtArenaHelper.Training.csproj" />
  </ItemGroup>

  <!--
    HDT-shipped assemblies. The plugin references them Private=False (they are
    bound inside HDT's process at runtime); tests run outside HDT, so they must
    be copied into the local test output. Never redistributed.
  -->
  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HSDTPath)\HearthstoneDeckTracker.exe</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HSDTPath)\HearthDb.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HSDTPath)\HearthMirror.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HSDTPath)\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
