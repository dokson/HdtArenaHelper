<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <Import Project="..\HSDT.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HdtArenaHelper\HdtArenaHelper.csproj" />
    <!-- CardPoolDump.Build(), for the drift test — see CardPoolDumpDriftTests.cs. -->
    <ProjectReference Include="..\HdtArenaHelper.Training\HdtArenaHelper.Training.csproj" />
  </ItemGroup>

  <!--
    The generated card pool, compiled here so the drift test can compare it against the live
    HearthDb this project already references. Never added to the PLUGIN csproj: the plugin reads
    HearthDb at runtime, so committing 1.7 MB of the same data into the shipped DLL buys nothing.
  -->
  <ItemGroup>
    <Compile Include="..\Generated\HSDatabase.g.cs" Link="Generated\HSDatabase.g.cs" />
  </ItemGroup>

  <!--
    HDT-shipped assemblies. The plugin references them Private=False (they are
    bound inside HDT's process at runtime); tests run outside HDT, so they must
    be copied into the local test output. Never redistributed.
  -->
  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HSDTPath)\HearthstoneDeckTracker.exe</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HSDTPath)\HearthDb.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HSDTPath)\HearthMirror.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HSDTPath)\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
