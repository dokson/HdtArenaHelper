<Project>
  <!--
    Applied to every project in the repo. Enforce the .editorconfig code-style rules
    at build time (not just in the IDE) so, e.g., IDE0005 "unused using directive" is
    reported by `dotnet build` and CI — no dead imports slip through.

    IDE0005 only fires during build when the XML documentation file is generated, so we
    enable that and suppress CS1591 (missing doc comment) to avoid unrelated noise.

    Warnings are ERRORS here, and that is the point: CI builds with -warnaserror, so a local
    build without it is a different check wearing the same green tick. That gap shipped a
    broken build once — a doc comment that documented one parameter out of three (CS1573)
    passed locally and failed CI after the push. One setting, one verdict, everywhere.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
