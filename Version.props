<Project>
  <PropertyGroup>
    <!-- Single source of truth: bump only <Version>. AssemblyVersion/FileVersion derive
         from it, get-version.ps1 reads it for the release tag, the plugin reports it.

         MUST stay 3-part (MAJOR.MINOR.PATCH), and so must the release tag. The self-updater
         compares (major, minor, build) only, so a 4-part hotfix like 0.1.2.1 would read as
         "not newer" on every installed client and reach nobody. build.yml rejects a tag that
         is not vMAJOR.MINOR.PATCH; SelfUpdaterTests pins the comparison. -->
    <Version>0.1.5</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Company>Alessandro Colace</Company>
    <Authors>Alessandro Colace</Authors>
  </PropertyGroup>
</Project>
