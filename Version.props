<Project>
  <PropertyGroup>
    <!-- Single source of truth: bump only <Version>. AssemblyVersion/FileVersion derive
         from it, get-version.ps1 reads it for the release tag, the plugin reports it. -->
    <Version>0.1.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Company>Alessandro Colace</Company>
    <Authors>Alessandro Colace</Authors>
  </PropertyGroup>
</Project>
