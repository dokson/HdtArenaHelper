# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.pdb

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo
*.userprefs

# NuGet
*.nupkg
packages/
project.lock.json

# OS
Thumbs.db
.DS_Store

# Local cached data downloaded at runtime (never commit)
*.cache
hsreplay_*.json

# Trainer output — regenerate with HdtArenaHelper.Training.
# The committed model is HdtArenaHelper.Training/arena_weights.json.
/HdtArenaHelper.Training/arena_weights.generated.json

# CI: pinned HDT reference assemblies downloaded by scripts/resolve-hdt.ps1
/.hdt/
# CI: packaged release zips
/dist/
# Editor / tooling local state
.claude/
.codegraph/

# Trainer payload snapshot: makes a fit reproducible / re-runnable offline, but it is
# a cache of someone else's public data and must never be committed or redistributed.
/HdtArenaHelper.Training/.snapshot/

# Trainer run metrics: a generated artifact of each fit, not an input.
/HdtArenaHelper.Training/metrics.json
