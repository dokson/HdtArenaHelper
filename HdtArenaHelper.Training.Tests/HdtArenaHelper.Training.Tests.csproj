<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <Import Project="..\HSDT.props" />

  <!--
    Tests for the trainer's deterministic pieces. Unlike HdtArenaHelper.Numerics.Tests this one
    DOES need HDT installed: the trainer references the plugin (to share BuildFeatures) and so
    pulls in HearthDb. Pure-maths tests therefore belong in Numerics.Tests, not here.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HdtArenaHelper.Training\HdtArenaHelper.Training.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HSDTPath)\HearthstoneDeckTracker.exe</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HSDTPath)\HearthDb.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HSDTPath)\HearthMirror.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HSDTPath)\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
