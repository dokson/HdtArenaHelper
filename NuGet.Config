<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin package restore to nuget.org only, so local and CI builds are reproducible
    and independent of any machine-wide NuGet feeds. Currently the project has no
    PackageReferences (HDT assemblies come via HintPath, WPF/BCL from the SDK); this
    is here for CI hygiene and for when packages are added later.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
